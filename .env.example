# Copy to .env (same folder) and fill in. Everything runs without this
# file: missing keys fall back to mock mode, printed at startup.

# ----- PayPal -----------------------------------------------------------
# sandbox = real PayPal sandbox REST calls; mock = no account needed.
# Orders and invoices use the buyer's currency (USD, GBP, EUR or AUD).
PAYPAL_ENV=sandbox
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id (dashboard > your app > Webhooks) to verify
# webhook signatures. Not needed for the pay/capture flow.
PAYPAL_WEBHOOK_ID=

# ----- LLM --------------------------------------------------------------
# anthropic | gemini | mock (rule-based, no key)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional. Defaults: claude-haiku-5-5 (anthropic), gemini-3.8-flash (gemini)
LLM_MODEL=

# ----- Server (defaults shown) -------------------------------------------
# PORT=8787
# WEB_ORIGIN=http://localhost:3000
# Public URL of /core; PayPal sends the buyer back to it after paying.
# PUBLIC_BASE_URL=http://localhost:8787
# Where the "back to the demo" links go.
# WEB_DEMO_URL=http://localhost:3000/demo
